[Unit]
Description=Ollama Helper FastAPI Service
After=network.target

[Service]
# Run as root
User=root
Group=root

# Project directory
WorkingDirectory=/opt/ollama-load-balancer-interface/worker_application

# Use Python inside the venv environment
ExecStart=/opt/ollama-load-balancer-interface/worker_application/venv/bin/python /opt/ollama-load-balancer-interface/worker_application/main.py

# Optionally load environment variables from a file
EnvironmentFile=/opt/ollama-load-balancer-interface/worker_application/ollama-helper.env

# Restart policy
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target