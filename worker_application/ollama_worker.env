# Secret API key shared between worker, watchdog, and server
OLLAMA_HELPER_API_KEY=your-secret-api-key

# Host and port where the worker API binds
WORKER_HOST=0.0.0.0
WORKER_PORT=18034

# Host and port where the watchdog API binds
WATCHDOG_HOST=0.0.0.0
WATCHDOG_PORT=18035

# Log level (optional: info, debug, warning, error, critical)
WORKER_LOG_LEVEL=info