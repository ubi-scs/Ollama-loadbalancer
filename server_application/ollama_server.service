[Unit]
Description=Ollama Server Service
After=network.target

[Service]
# Run as root
User=root
Group=root

# Project directory
WorkingDirectory=/home/scsadmin/ollama-load-balancer-interface/server_application

# Use Python inside the venv environment
ExecStart=/home/scsadmin/ollama-load-balancer-interface/server_application/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 18034

# Optionally load environment variables from a file
EnvironmentFile=/home/scsadmin/ollama-load-balancer-interface/server_application/ollama_server.env

# Restart policy
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target