
# Secret API key used by the worker
ADMIN_PASSWORD=your-secret-api-key
OLLAMA_HELPER_API_KEY=your-secret-api-key

# Host and port where uvicorn should bind (optional, defaults to 0.0.0.0:8000)
WORKER_HOST=0.0.0.0
WORKER_PORT=8080

# Log level (optional: info, debug, warning, error, critical)
WORKER_LOG_LEVEL=info